# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URL=mongodb://localhost:27017/project-management

# Auth
JWT_SECRET_KEY=replace_with_secure_random_string

# OTP purpose keys
OTP_PURPOSE_REGISTRATION=registration
OTP_PURPOSE_LOGIN_2FA=login_2fa
OTP_PURPOSE_FORGET_PASSWORD=forget_password

# Brevo SMTP (required for OTP/email delivery)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SENDER_EMAIL=verified_sender@example.com

# Redis (optional; required only for BullMQ queues)
# For hosted Redis (Render/Upstash/Redis Cloud):
# REDIS_URL=******host:6379
# Or for host/port mode:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_KEY_PREFIX=devdash

# Optional API rate-limits
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
